  <nav class="flex items-center justify-between px-6 py-3 bg-white border-b border-gray-200 sticky top-0 z-50">
    <div class="flex items-center gap-2">
      <div class="bg-primary rounded-lg p-1.5">
                    <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                    </svg>
                </div>
      <span class="text-base font-semibold text-gray-900">Satva</span>
    </div>
    <div class="flex items-center gap-4">
      <i class="ti ti-bell text-xl text-gray-500 cursor-pointer"></i>
      <i class="ti ti-user text-xl text-gray-500 cursor-pointer"></i>
      <button class="flex items-center gap-2 bg-red-500 text-white text-sm font-medium px-4 py-2 rounded-lg hover:bg-red-600 transition" id="logout-btn">
        <i class="ti ti-logout text-base"></i>
        Logout
      </button>
    </div>
  </nav>


  <script>
  document.getElementById("logout-btn").addEventListener("click",async()=>{

    try {
        const token = localStorage.getItem("accessToken");
        if (token) {
            await fetch('/api/v1/auth/logout', {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${token}`
                }
            });
        }
    } catch (error) {
        console.error("Logout failed on server, clearing client session anyway.", error);
    } finally {
        localStorage.clear();
        window.location.href = '/login';
    }
  })
  </script>