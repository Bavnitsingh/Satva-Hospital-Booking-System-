<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Satva - Reset Password</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              primary: "#10A37F",
              "primary-dark": "#0d8a6a",
              "primary-light": "#e6f7f3",
              "bg-page": "#f0faf6",
              dark: "#0f1923",
            },
            fontFamily: {
              sans: ["DM Sans", "sans-serif"],
              display: ["Playfair Display", "serif"],
            },
          },
        },
      };
    </script>

    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body
    class="min-h-screen bg-gradient-to-br from-primary-light to-white flex items-center justify-center p-5 font-sans"
  >
    <div
      class="w-full max-w-md bg-white rounded-2xl shadow-xl p-8"
    >
      <!-- Header -->
      <div class="text-center mb-6">
        <div
          class="font-display text-4xl font-extrabold text-primary mb-4"
        >
          SATVA
        </div>

        <h1 class="text-3xl font-bold text-dark mb-2">
          Reset Password
        </h1>

        <p class="text-gray-500 text-sm leading-relaxed">
          Create a strong password with letters, numbers,
          and symbols for better security.
        </p>
      </div>

      <!-- Form -->
     ```html
<form id="resetForm" class="space-y-4">
  <div>
    <input
      type="text"
      name="otp"
      maxlength="6"
      required
      placeholder="Enter 4-6 digit code"
      class="w-full px-4 py-3.5 border border-gray-300 rounded-lg text-sm outline-none transition focus:border-primary focus:ring-4 focus:ring-primary/20"
    />
  </div>

  <div>
    <input
      type="password"
      name="newPassword"
      required
      placeholder="New password"
      class="w-full px-4 py-3.5 border border-gray-300 rounded-lg text-sm outline-none transition focus:border-primary focus:ring-4 focus:ring-primary/20"
    />
  </div>

  <div>
    <input
      type="password"
      name="confirm_password"
      required
      placeholder="Confirm password"
      class="w-full px-4 py-3.5 border border-gray-300 rounded-lg text-sm outline-none transition focus:border-primary focus:ring-4 focus:ring-primary/20"
    />
  </div>

  <button
    type="submit"
    id="changePassword"
    class="w-full flex items-center justify-center bg-primary hover:bg-primary-dark text-white font-semibold py-3.5 rounded-lg transition-colors duration-200"
  >
    Change Password
  </button>
</form>

<script>
  document
    .getElementById("resetForm")
    .addEventListener("submit", async (e) => {
      e.preventDefault();

      const userTimezone =
        Intl.DateTimeFormat().resolvedOptions().timeZone;

      const formData = new FormData(e.target);
      const formEntries = Object.fromEntries(formData.entries());

      formEntries.timezone = userTimezone;

      try {
        const response = await fetch(
          "/api/v1/auth/reset-password",
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(formEntries),
          }
        );

        const data = await response.json();

        if (response.ok) {
          showMessage(
            data.message || "Password reset successful",
            false
          );

          setTimeout(() => {
            window.location.href = "/login";
          }, 1000);
        } else {
          showMessage(
            data.message || "Failed to reset password"
          );
        }
      } catch (err) {
        console.error(err);
        showMessage("Something went wrong");
      }
    });

  function showMessage(message, isError = true) {
    const alert = document.createElement("div");

    alert.className =
      `fixed top-4 left-1/2 -translate-x-1/2 z-50 px-4 py-3 rounded-lg shadow-lg text-white font-medium ` +
      (isError ? "bg-red-500" : "bg-green-500");

    alert.textContent = message;

    document.body.appendChild(alert);

    setTimeout(() => {
      alert.remove();
    }, 3000);
  }
</script>
```
</body>

</html>