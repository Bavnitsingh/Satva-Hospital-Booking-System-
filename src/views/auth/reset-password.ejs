<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Reset Password</title>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Syne:wght@400;600;700;800&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #0d0f12;
      --surface: #141720;
      --surface2: #1c2030;
      --border: #252a3a;
      --accent: #4f8cff;
      --accent2: #a78bfa;
      --green: #34d399;
      --red: #f87171;
      --yellow: #fbbf24;
      --text: #e8ecf5;
      --muted: #7c849e;
      --mono: 'IBM Plex Mono', monospace;
      --sans: 'Syne', sans-serif;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--sans);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      overflow: hidden;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(var(--border) 1px, transparent 1px),
        linear-gradient(90deg, var(--border) 1px, transparent 1px);
      background-size: 48px 48px;
      opacity: .35;
      pointer-events: none;
    }

    .blob {
      position: fixed;
      border-radius: 50%;
      filter: blur(90px);
      pointer-events: none;
      opacity: .1;
    }
    .blob-1 { width: 360px; height: 360px; background: var(--accent2); top: -80px; right: -60px; }
    .blob-2 { width: 280px; height: 280px; background: var(--green); bottom: -60px; left: -40px; }

    .card {
      position: relative;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 44px 40px 40px;
      width: 100%;
      max-width: 420px;
      box-shadow: 0 24px 80px #00000060;
      animation: cardIn .5s cubic-bezier(.22,1,.36,1) both;
    }
    @keyframes cardIn {
      from { opacity: 0; transform: translateY(24px) scale(.97); }
      to   { opacity: 1; transform: none; }
    }

    /* Success overlay */
    .success-overlay {
      position: absolute;
      inset: 0;
      background: var(--surface);
      border-radius: 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      opacity: 0;
      pointer-events: none;
      transition: opacity .4s;
      z-index: 10;
      padding: 40px;
      text-align: center;
    }
    .success-overlay.show { opacity: 1; pointer-events: all; }
    .success-icon {
      width: 72px; height: 72px;
      border-radius: 50%;
      background: #34d39918;
      border: 2px solid #34d39950;
      display: flex; align-items: center; justify-content: center;
      font-size: 32px;
      animation: popIn .4s cubic-bezier(.34,1.56,.64,1) both .1s;
    }
    @keyframes popIn {
      from { transform: scale(0); opacity: 0; }
      to   { transform: none; opacity: 1; }
    }
    .success-title { font-size: 22px; font-weight: 800; }
    .success-text  { font-size: 14px; color: var(--muted); line-height: 1.6; }

    .card-top { text-align: center; margin-bottom: 32px; }
    .icon-wrap {
      width: 64px; height: 64px;
      border-radius: 18px;
      background: linear-gradient(135deg, #a78bfa18, #4f8cff18);
      border: 1.5px solid #a78bfa40;
      display: flex; align-items: center; justify-content: center;
      font-size: 28px;
      margin: 0 auto 18px;
    }
    h1 { font-size: 24px; font-weight: 800; letter-spacing: -.4px; margin-bottom: 8px; }
    .subtitle { font-size: 13.5px; color: var(--muted); line-height: 1.6; }

    .field { margin-bottom: 18px; }
    label {
      display: block;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 8px;
    }
    .input-wrap {
      position: relative;
    }
    input[type="password"],
    input[type="text"] {
      width: 100%;
      padding: 13px 44px 13px 14px;
      background: var(--surface2);
      border: 1.5px solid var(--border);
      border-radius: 10px;
      color: var(--text);
      font-family: var(--mono);
      font-size: 15px;
      outline: none;
      transition: border-color .2s, box-shadow .2s;
    }
    input:focus {
      border-color: var(--accent2);
      box-shadow: 0 0 0 3px #a78bfa22;
    }
    input.valid   { border-color: #34d39960; }
    input.invalid { border-color: #f8717160; }

    .toggle-pw {
      position: absolute;
      right: 13px; top: 50%;
      transform: translateY(-50%);
      background: none; border: none;
      color: var(--muted); cursor: pointer;
      font-size: 17px; line-height: 1;
      padding: 2px;
    }
    .toggle-pw:hover { color: var(--text); }

    /* Strength meter */
    .strength-wrap { margin-top: 10px; }
    .strength-bars {
      display: flex; gap: 5px; margin-bottom: 6px;
    }
    .strength-bar {
      flex: 1; height: 4px; border-radius: 2px;
      background: var(--border);
      transition: background .3s;
    }
    .strength-bar.weak   { background: var(--red); }
    .strength-bar.medium { background: var(--yellow); }
    .strength-bar.strong { background: var(--green); }
    .strength-label {
      font-size: 11.5px;
      color: var(--muted);
      font-family: var(--mono);
    }

    /* Password rules */
    .rules {
      margin-top: 12px;
      display: grid; grid-template-columns: 1fr 1fr; gap: 6px;
    }
    .rule {
      font-size: 11.5px;
      color: var(--muted);
      display: flex; align-items: center; gap: 6px;
      transition: color .2s;
    }
    .rule-dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--border);
      flex-shrink: 0;
      transition: background .2s;
    }
    .rule.pass { color: var(--green); }
    .rule.pass .rule-dot { background: var(--green); }

    .match-hint {
      font-size: 12px;
      margin-top: 8px;
      font-family: var(--mono);
      min-height: 18px;
    }
    .match-hint.ok  { color: var(--green); }
    .match-hint.no  { color: var(--red); }

    .btn-submit {
      width: 100%;
      margin-top: 8px;
      padding: 15px;
      background: linear-gradient(135deg, var(--accent2), var(--accent));
      color: #fff;
      border: none;
      border-radius: 12px;
      font-family: var(--sans);
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      transition: opacity .2s, transform .15s;
      box-shadow: 0 4px 24px #a78bfa28;
    }
    .btn-submit:hover  { opacity: .9; transform: translateY(-1px); }
    .btn-submit:active { transform: translateY(0); }
    .btn-submit:disabled { opacity: .4; cursor: not-allowed; transform: none; }

    .redirect-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: linear-gradient(135deg, var(--green), #059669);
      color: #fff;
      border: none;
      border-radius: 10px;
      padding: 13px 28px;
      font-family: var(--sans);
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      text-decoration: none;
      margin-top: 8px;
      transition: opacity .2s, transform .15s;
      box-shadow: 0 4px 20px #34d39930;
    }
    .redirect-btn:hover { opacity: .9; transform: translateY(-1px); }
  </style>
</head>
<body>
  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>

  <div class="card">
    <!-- Success overlay (shown after update) -->
    <div class="success-overlay" id="successOverlay">
      <div class="success-icon">✅</div>
      <div class="success-title">Password Updated!</div>
      <p class="success-text">Your password has been changed successfully. You can now log in with your new credentials.</p>
      <a href="/login" class="redirect-btn">→ Go to Login</a>
    </div>

    <div class="card-top">
      <div class="icon-wrap">🛡️</div>
      <h1>New Password</h1>
      <p class="subtitle">Choose a strong password to secure your account.</p>
    </div>

    <form id="resetForm" action="/reset-password" method="POST" onsubmit="return handleSubmit(event)">
      <!-- OTP is already verified by session; but we still send it from session server-side -->

      <div class="field">
        <label for="newPassword">New Password</label>
        <div class="input-wrap">
          <input type="password" id="newPassword" name="newPassword" placeholder="••••••••••••"
            autocomplete="new-password" oninput="onPasswordInput()" required />
          <button type="button" class="toggle-pw" onclick="togglePw('newPassword', this)" tabindex="-1">👁</button>
        </div>

        <div class="strength-wrap">
          <div class="strength-bars">
            <div class="strength-bar" id="sb1"></div>
            <div class="strength-bar" id="sb2"></div>
            <div class="strength-bar" id="sb3"></div>
            <div class="strength-bar" id="sb4"></div>
          </div>
          <div class="strength-label" id="strengthLabel">Enter a password</div>
        </div>

        <div class="rules">
          <div class="rule" id="rLen"><span class="rule-dot"></span>Min 8 chars</div>
          <div class="rule" id="rUp"><span class="rule-dot"></span>Uppercase</div>
          <div class="rule" id="rNum"><span class="rule-dot"></span>Number</div>
          <div class="rule" id="rSym"><span class="rule-dot"></span>Symbol</div>
        </div>
      </div>

      <div class="field">
        <label for="confirmPassword">Confirm Password</label>
        <div class="input-wrap">
          <input type="password" id="confirmPassword" name="confirmPassword" placeholder="••••••••••••"
            autocomplete="new-password" oninput="onConfirmInput()" required />
          <button type="button" class="toggle-pw" onclick="togglePw('confirmPassword', this)" tabindex="-1">👁</button>
        </div>
        <div class="match-hint" id="matchHint"></div>
      </div>

      <button class="btn-submit" id="submitBtn" type="submit" disabled>Update Password</button>
    </form>
  </div>

  <script>
    const bars = [document.getElementById('sb1'), document.getElementById('sb2'), document.getElementById('sb3'), document.getElementById('sb4')];
    const strengthLabel = document.getElementById('strengthLabel');
    const rules = {
      rLen: v => v.length >= 8,
      rUp:  v => /[A-Z]/.test(v),
      rNum: v => /[0-9]/.test(v),
      rSym: v => /[^A-Za-z0-9]/.test(v),
    };

    function getStrength(v) {
      const score = Object.values(rules).filter(fn => fn(v)).length;
      return score;
    }

    function onPasswordInput() {
      const v = document.getElementById('newPassword').value;
      const score = getStrength(v);

      // update rule UI
      Object.entries(rules).forEach(([id, fn]) => {
        document.getElementById(id).classList.toggle('pass', fn(v));
      });

      // strength bars
      const cls = score <= 1 ? 'weak' : score <= 3 ? 'medium' : 'strong';
      const labels = ['', 'Weak', 'Fair', 'Good', 'Strong'];
      bars.forEach((b, i) => {
        b.className = 'strength-bar';
        if (i < score) b.classList.add(cls);
      });
      strengthLabel.textContent = v ? labels[score] || 'Strong' : 'Enter a password';
      strengthLabel.style.color = cls === 'weak' ? 'var(--red)' : cls === 'medium' ? 'var(--yellow)' : 'var(--green)';

      onConfirmInput();
      checkSubmit();
    }

    function onConfirmInput() {
      const pw  = document.getElementById('newPassword').value;
      const cpw = document.getElementById('confirmPassword').value;
      const hint = document.getElementById('matchHint');
      if (!cpw) { hint.textContent = ''; hint.className = 'match-hint'; return; }
      if (pw === cpw) {
        hint.textContent = '✓ Passwords match';
        hint.className = 'match-hint ok';
      } else {
        hint.textContent = '✗ Passwords do not match';
        hint.className = 'match-hint no';
      }
      checkSubmit();
    }

    function checkSubmit() {
      const pw  = document.getElementById('newPassword').value;
      const cpw = document.getElementById('confirmPassword').value;
      const score = getStrength(pw);
      document.getElementById('submitBtn').disabled = !(score >= 3 && pw === cpw);
    }

    function togglePw(id, btn) {
      const inp = document.getElementById(id);
      const isText = inp.type === 'text';
      inp.type = isText ? 'password' : 'text';
      btn.textContent = isText ? '👁' : '🙈';
    }

    async function handleSubmit(e) {
      e.preventDefault();
      const pw  = document.getElementById('newPassword').value;
      const cpw = document.getElementById('confirmPassword').value;
      if (pw !== cpw) return false;

      const btn = document.getElementById('submitBtn');
      btn.disabled = true;
      btn.textContent = 'Updating…';

      try {
        const res = await fetch('/reset-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ newPassword: pw })
        });

        if (res.ok) {
          document.getElementById('successOverlay').classList.add('show');
        } else {
          const data = await res.json();
          alert(data.message || 'Something went wrong. Please try again.');
          btn.disabled = false;
          btn.textContent = 'Update Password';
        }
      } catch (err) {
        alert('Network error. Please try again.');
        btn.disabled = false;
        btn.textContent = 'Update Password';
      }
    }
  </script>
</body>
</html>
