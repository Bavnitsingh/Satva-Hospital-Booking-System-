<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>OTP Email</title>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial;
  }

  body {
    background: #f4f6f8;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    padding: 20px;
  }

  .card {
    width: 100%;
    max-width: 420px;
    background: #fff;
    border-radius: 12px;
    padding: 24px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
  }

  .header {
    text-align: center;
    margin-bottom: 20px;
  }

  .logo {
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .title {
    font-size: 18px;
    font-weight: 600;
    color: #111;
  }

  .subtitle {
    font-size: 13px;
    color: #666;
    margin-top: 4px;
  }

  .box {
    margin-top: 20px;
    padding: 18px;
    border: 1px solid #eee;
    border-radius: 10px;
    text-align: center;
    background: #fafafa;
  }

  .label {
    font-size: 12px;
    color: #777;
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .otp {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: 6px;
    color: #2563eb;
  }

  .expiry {
    margin-top: 8px;
    font-size: 12px;
    color: #888;
  }

  .message {
    margin-top: 18px;
    font-size: 13px;
    color: #555;
    line-height: 1.5;
    text-align: center;
  }

  .btn {
    display: block;
    margin-top: 20px;
    text-align: center;
    background: #2563eb;
    color: #fff;
    padding: 12px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
  }

  .btn:hover {
    background: #1d4ed8;
  }

  .footer {
    margin-top: 18px;
    font-size: 11px;
    color: #999;
    text-align: center;
  }
</style>
</head>

<body>

<div class="card">

  <div class="header">
    <div class="logo">🔒</div>
    <div class="title">Password Reset OTP</div>
    <div class="subtitle">Secure verification code</div>
  </div>

  <div class="box">
    <div class="label">Your OTP</div>
    <div class="otp"><%= otp_code %></div>
    <div class="expiry">Valid for 2 minutes</div>
  </div>

  <div class="message">
    Use this OTP to reset your password. Do not share this code with anyone.
  </div>

  <a href="/api/v1/auth/enter-otp-page" class="btn">
    Reset Password
  </a>

  <div class="footer">
    If you didn’t request this, you can ignore this email.
  </div>

</div>

</body>
</html>