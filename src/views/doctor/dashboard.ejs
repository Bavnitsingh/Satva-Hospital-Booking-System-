<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>HealthCare – Dr. Michael Chen</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.3.0/flowbite.min.js"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
    body { font-family: 'Inter', sans-serif; }
  </style>
    <script src="/js/checkAuth.js" ></script>
</head>
<body class="bg-gray-50 min-h-screen">
  <!-- ───────────── NAVBAR ───────────── -->
  <header class="bg-white border-b border-gray-100 sticky top-0 z-30">
    <div class="max-w-7xl mx-auto px-6 py-3 flex items-center justify-between">
      <!-- Logo -->
      <div class="flex items-center gap-2">
        <div class="bg-teal-600 rounded-xl p-1.5">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
          </svg>
        </div>
        <span class="text-gray-800 font-semibold text-lg tracking-tight">Satva</span>
      </div>
      <!-- Right actions -->
      <div class="flex items-center gap-3">
        <button class="p-2 rounded-full text-gray-500 hover:bg-gray-100 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
          </svg>
        </button>
        <button class="p-2 rounded-full text-gray-500 hover:bg-gray-100 transition"  onclick="window.location.href='/doctor/profile'">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        </button>
        <button class="flex items-center gap-2 bg-red-500 hover:bg-red-600 text-white text-sm font-medium px-4 py-2 rounded-lg transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
          </svg>
          Logout
        </button>
      </div>
    </div>
  </header>

  <!-- ───────────── MAIN CONTENT ───────────── -->
  <main class="max-w-7xl mx-auto px-6 py-8 space-y-6">

    <!-- Doctor Info -->
    <div>
      <h1 class="text-2xl font-bold text-gray-900" id="doctor-info"></h1>
      <p class="text-gray-500 text-sm mt-0.5" id="doctor-special">Cardiologist &bull; 15 years experience</p>
    </div>

  <%-include('partials/stats.ejs');%>

    <!-- Tab Navigation -->
    <div class="border-b border-gray-200">
      <nav class="-mb-px flex gap-6" aria-label="Tabs">
        <button onclick="setTab('today')"   class="tab-btn tab-today-btn pb-3 text-sm font-medium text-gray-500 border-b-2 border-transparent hover:text-teal-600 hover:border-teal-300 transition">Today's Schedule</button>
        <button onclick="setTab('weekly')"  class="tab-btn  tab-weekly-btn pb-3 text-sm font-medium text-gray-500 border-b-2 border-transparent hover:text-teal-600 hover:border-teal-300 transition">Weekly Schedule</button>
        <button onclick="setTab('patients')" class="tab-btn tab-patients-btn pb-3 text-sm font-medium text-teal-600 border-b-2 border-teal-600 transition">Patient List</button>
        <!-- <button onclick="setTab('records')" class="tab-btn pb-3 text-sm font-medium text-gray-500 border-b-2 border-transparent hover:text-teal-600 hover:border-teal-300 transition">Medical Records</button> -->
      </nav>
    </div>

    <!-- Patient List -->
     <%-include('patient_list.ejs');%>
   <!-- /tab-patients -->
    
    <%- include('today_schedule.ejs');%>
    <!-- Placeholder panels for other tabs -->
    <%- include('weekly_schedule.ejs');%>
    <div id="tab-records" class="tab-panel hidden"><p class="text-gray-400 text-sm py-8 text-center">Medical records will appear here.</p></div>

  </main>

  <script>
    const tabMap = { today: 'tab-today', weekly: 'tab-weekly', patients: 'tab-patients', records: 'tab-records' };

    
    const tab_panel=localStorage.getItem('tab-panel')
    console.log(tab_panel)
    if(!tab_panel){
    
      setTab('today')
    }
    else{
    setTab(tab_panel)}

    function setTab(key) {
      let btn=document.querySelector(`.${tabMap[key]}-btn`)

      document.querySelectorAll('.tab-panel').forEach(p => p.classList.add('hidden'));
   
      document.querySelectorAll('.tab-btn').forEach(b => {
        b.classList.remove('text-teal-600', 'border-teal-600');
        b.classList.add('text-gray-500', 'border-transparent');
      });
      // show selected
      localStorage.setItem("tab-panel",key) 
    
      document.getElementById(tabMap[key]).classList.remove('hidden');
      
      btn.classList.remove('text-gray-500', 'border-transparent');
      btn.classList.add('text-teal-600', 'border-teal-600');
    }
  </script>
  <script src="/js/doctor.js"></script>
  <script src="/js/today_schedule.js"></script>

</body>
</html>
