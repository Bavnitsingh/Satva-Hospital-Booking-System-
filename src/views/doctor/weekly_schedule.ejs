<%
  // ── weekly_schedule.ejs ─────────────────────────────────────────────
  // Expected server variable (optional):
  //   weeklyConfig[]  — array of 7 objects (Mon–Sun) each:
  //   {
  //     date        : 'YYYY-MM-DD',
  //     start_time  : '09:00',
  //     end_time    : '17:00',
  //     slot_duration: 30,          // minutes
  //     is_available : true,
  //     unavailable_reason: ''
  //   }
  //
  //   weeklyAppointments  — object keyed by 'YYYY-MM-DD'
  //     each value: appointment[]  (same shape as today)
  //
  // Falls back to demo data when these are undefined.

  const DAY_NAMES  = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
  const DAY_SHORT  = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
  const MONTH_ABBR = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

  // Build the 7-day window starting Monday of the current week
  function getMondayOf(d) {
    const day = d.getDay();                     // 0=Sun
    const diff = (day === 0) ? -6 : 1 - day;   // shift to Monday
    const m = new Date(d);
    m.setDate(d.getDate() + diff);
    m.setHours(0,0,0,0);
    return m;
  }

  function toYMD(d) {
    return d.getFullYear() + '-' +
           String(d.getMonth()+1).padStart(2,'0') + '-' +
           String(d.getDate()).padStart(2,'0');
  }

  const today   = new Date();
  const monday  = getMondayOf(today);
  const weekDays = [];
  for (let i = 0; i < 7; i++) {
    const d = new Date(monday);
    d.setDate(monday.getDate() + i);
    weekDays.push(d);
  }

  // ─── Demo per-day config (replace with your real weeklyConfig var) ──
  const defaultConfig = [
    { start_time:'09:00', end_time:'17:00', slot_duration:30,  is_available:true },
    { start_time:'08:30', end_time:'16:30', slot_duration:20,  is_available:true },
    { start_time:'10:00', end_time:'18:00', slot_duration:45,  is_available:true },
    { start_time:'09:00', end_time:'15:00', slot_duration:30,  is_available:true },
    { start_time:'08:00', end_time:'14:00', slot_duration:25,  is_available:true },
    { start_time:'09:00', end_time:'13:00', slot_duration:30,  is_available:true },
    { start_time:'00:00', end_time:'00:00', slot_duration:30,  is_available:false, unavailable_reason:'Weekend' },
  ];

  // ─── Demo appointments per day ──────────────────────────────────────
  const demoAppts = {
    0: [ // Monday
      { time:'9',  period:'AM', patient_name:'Alice Morgan',    age:34, status:'upcoming',    reason:'Routine checkup',       type:'in_person'    },
      { time:'10', period:'AM', patient_name:'Brian Cooper',    age:47, status:'upcoming',    reason:'Follow-up consultation',type:'telemedicine' },
    ],
    1: [ // Tuesday
      { time:'9',  period:'AM', patient_name:'Carla Diaz',      age:29, status:'completed',   reason:'Blood test review',     type:'in_person'    },
      { time:'11', period:'AM', patient_name:'Daniel Evans',    age:58, status:'upcoming',    reason:'ECG interpretation',    type:'in_person'    },
    ],
    2: [ // Wednesday
      { time:'10', period:'AM', patient_name:'Emily Foster',    age:41, status:'in_progress', reason:'Hypertension review',   type:'telemedicine' },
    ],
    3: [ // Thursday
      { time:'9',  period:'AM', patient_name:'Frank Green',     age:63, status:'upcoming',    reason:'Post-op check',         type:'in_person'    },
      { time:'2',  period:'PM', patient_name:'Grace Hall',      age:37, status:'upcoming',    reason:'Preventive care',       type:'telemedicine' },
    ],
    4: [ // Friday
      { time:'8',  period:'AM', patient_name:'Henry Irwin',     age:50, status:'upcoming',    reason:'Stress test results',   type:'in_person'    },
    ],
    5: [],  // Saturday (available but no appts)
    6: [],  // Sunday (unavailable)
  };
%>

<div id="tab-weekly" class="tab-panel hidden space-y-5">

  <!-- ── Section title ── -->
  <div class="flex items-center justify-between">
    <h2 class="text-base font-semibold text-gray-900">Weekly Schedule</h2>
    <span class="text-xs text-gray-400">
      <%= DAY_NAMES[monday.getDay()] %> <%= monday.getDate() %> <%= MONTH_ABBR[monday.getMonth()] %>
      &ndash;
      <%= DAY_NAMES[weekDays[6].getDay()] %> <%= weekDays[6].getDate() %> <%= MONTH_ABBR[weekDays[6].getMonth()] %>
    </span>
  </div>

  <!-- ── Day pill selector ── -->
  <div class="flex gap-2 overflow-x-auto pb-1 scrollbar-none" id="week-day-tabs">
    <% weekDays.forEach(function(d, idx) {
        const ymd       = toYMD(d);
        const isToday   = toYMD(today) === ymd;
        const cfg       = (typeof weeklyConfig !== 'undefined' && weeklyConfig[idx]) ? weeklyConfig[idx] : defaultConfig[idx];
        const available = cfg.is_available;
    %>
      <button
        onclick="selectWeekDay(<%= idx %>)"
        id="wday-btn-<%= idx %>"
        data-idx="<%= idx %>"
        class="wday-btn flex-shrink-0 flex flex-col items-center px-4 py-2.5 rounded-xl border text-xs font-medium transition
               <%= isToday ? 'bg-teal-600 text-white border-teal-600' : available ? 'bg-white text-gray-600 border-gray-200 hover:border-teal-300 hover:text-teal-600' : 'bg-gray-50 text-gray-300 border-gray-100 cursor-default' %>">
        <span class="text-[11px] uppercase tracking-wide <%= isToday ? 'text-teal-100' : 'text-gray-400' %>"><%= DAY_SHORT[d.getDay()] %></span>
        <span class="text-base font-bold mt-0.5 leading-none"><%= d.getDate() %></span>
        <% if (!available) { %>
          <span class="mt-1 w-1 h-1 rounded-full bg-gray-300 inline-block"></span>
        <% } else { %>
          <span class="mt-1 w-1 h-1 rounded-full <%= isToday ? 'bg-teal-300' : 'bg-teal-400' %> inline-block"></span>
        <% } %>
      </button>
    <% }); %>
  </div>

  <!-- ── Per-day panels ── -->
  <% weekDays.forEach(function(d, idx) {
      const ymd  = toYMD(d);
      const cfg  = (typeof weeklyConfig !== 'undefined' && weeklyConfig[idx]) ? weeklyConfig[idx] : defaultConfig[idx];
      const appts = (typeof weeklyAppointments !== 'undefined' && weeklyAppointments[ymd])
                    ? weeklyAppointments[ymd]
                    : (demoAppts[idx] || []);
      const isToday = toYMD(today) === ymd;
  %>

    <div id="wday-panel-<%= idx %>" class="wday-panel space-y-4 <%= idx !== ((() => { const day=today.getDay(); return day===0?6:day-1; })()) ? 'hidden' : '' %>">

      <!-- Date + availability badge -->
      <div class="flex items-center justify-between">
        <div>
          <p class="font-semibold text-gray-900 text-sm">
            <%= DAY_NAMES[d.getDay()] %>, <%= d.getDate() %> <%= MONTH_ABBR[d.getMonth()] %> <%= d.getFullYear() %>
            <% if (isToday) { %><span class="ml-2 text-xs font-medium text-teal-600 bg-teal-50 px-2 py-0.5 rounded-full">Today</span><% } %>
          </p>
          <p class="text-xs text-gray-400 mt-0.5"><%= appts.length %> appointment<%= appts.length !== 1 ? 's' : '' %> scheduled</p>
        </div>
        <% if (!cfg.is_available) { %>
          <span class="text-xs font-medium text-red-500 bg-red-50 px-3 py-1 rounded-full"><%= cfg.unavailable_reason || 'Unavailable' %></span>
        <% } else { %>
          <span class="text-xs font-medium text-emerald-600 bg-emerald-50 px-3 py-1 rounded-full">Available</span>
        <% } %>
      </div>

      <% if (cfg.is_available) { %>

        <!-- ── Slot config card ── -->
        <div class="bg-teal-50 border border-teal-100 rounded-2xl px-5 py-4">
          <p class="text-xs font-semibold text-teal-700 uppercase tracking-wide mb-3">Slot Configuration</p>
          <div class="grid grid-cols-3 gap-4">
            <!-- Start Time -->
            <div>
              <label class="block text-xs text-gray-500 mb-1">Start Time</label>
              <div class="relative">
                <select onchange="updateSlotConfig(<%= idx %>, 'start_time', this.value)"
                        class="w-full appearance-none bg-white border border-gray-200 text-gray-800 text-sm font-medium rounded-lg px-3 py-2 pr-7 focus:outline-none focus:ring-2 focus:ring-teal-400 transition">
                  <% ['06:00','06:30','07:00','07:30','08:00','08:30','09:00','09:30','10:00','10:30','11:00','11:30','12:00'].forEach(function(t){ %>
                    <option value="<%= t %>" <%= cfg.start_time === t ? 'selected' : '' %>><%= t %></option>
                  <% }); %>
                </select>
                <span class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 text-gray-400">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                  </svg>
                </span>
              </div>
            </div>
            <!-- End Time -->
            <div>
              <label class="block text-xs text-gray-500 mb-1">End Time</label>
              <div class="relative">
                <select onchange="updateSlotConfig(<%= idx %>, 'end_time', this.value)"
                        class="w-full appearance-none bg-white border border-gray-200 text-gray-800 text-sm font-medium rounded-lg px-3 py-2 pr-7 focus:outline-none focus:ring-2 focus:ring-teal-400 transition">
                  <% ['13:00','13:30','14:00','14:30','15:00','15:30','16:00','16:30','17:00','17:30','18:00','18:30','19:00','20:00'].forEach(function(t){ %>
                    <option value="<%= t %>" <%= cfg.end_time === t ? 'selected' : '' %>><%= t %></option>
                  <% }); %>
                </select>
                <span class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 text-gray-400">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                  </svg>
                </span>
              </div>
            </div>
            <!-- Slot Duration -->
            <div>
              <label class="block text-xs text-gray-500 mb-1">Slot Duration</label>
              <div class="relative">
                <select onchange="updateSlotConfig(<%= idx %>, 'slot_duration', this.value)"
                        class="w-full appearance-none bg-white border border-gray-200 text-gray-800 text-sm font-medium rounded-lg px-3 py-2 pr-7 focus:outline-none focus:ring-2 focus:ring-teal-400 transition">
                  <% [10,15,20,25,30,45,60].forEach(function(m){ %>
                    <option value="<%= m %>" <%= cfg.slot_duration === m ? 'selected' : '' %>><%= m %> min</option>
                  <% }); %>
                </select>
                <span class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 text-gray-400">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                  </svg>
                </span>
              </div>
            </div>
          </div>
          <button onclick="saveSlotConfig(<%= idx %>)"
                  class="mt-4 w-full bg-teal-600 hover:bg-teal-700 text-white text-sm font-semibold py-2.5 rounded-xl transition">
            Save Slot Configuration
          </button>
        </div>

        <!-- ── Appointments for this day ── -->
        <% if (appts.length > 0) { %>
          <div class="space-y-3">
            <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide">Appointments</p>

            <% appts.forEach(function(appt) {
                let badgeCls = '', badgeLabel = '';
                if (appt.status === 'upcoming')    { badgeCls = 'bg-blue-50 text-blue-600';       badgeLabel = 'Upcoming';    }
                if (appt.status === 'in_progress') { badgeCls = 'bg-amber-50 text-amber-600';     badgeLabel = 'In Progress'; }
                if (appt.status === 'completed')   { badgeCls = 'bg-emerald-50 text-emerald-600'; badgeLabel = 'Completed';   }
                const isTele = appt.type === 'telemedicine';
            %>
              <div class="bg-white rounded-2xl border border-gray-100 shadow-sm px-5 py-4 flex items-center gap-4">
                <!-- Time -->
                <div class="flex-shrink-0 w-12 text-center">
                  <p class="text-lg font-bold text-teal-600 leading-none"><%= appt.time %></p>
                  <p class="text-xs text-gray-400 mt-0.5 uppercase tracking-wide"><%= appt.period %></p>
                </div>
                <div class="flex-shrink-0 w-px h-9 bg-gray-100"></div>
                <!-- Info -->
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 flex-wrap">
                    <p class="font-semibold text-gray-900 text-sm"><%= appt.patient_name %></p>
                    <span class="text-xs text-gray-400">Age: <%= appt.age %></span>
                    <span class="text-xs font-medium px-2 py-0.5 rounded-full <%= badgeCls %>"><%= badgeLabel %></span>
                  </div>
                  <p class="text-xs text-gray-500 mt-0.5 truncate"><%= appt.reason %></p>
                  <div class="flex items-center gap-1 mt-1">
                    <% if (isTele) { %>
                      <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.069A1 1 0 0121 8.82v6.36a1 1 0 01-1.447.894L15 14M3 8a2 2 0 012-2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8z"/>
                      </svg>
                      <span class="text-xs text-gray-400">Telemedicine</span>
                    <% } else { %>
                      <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 4h10M5 11h14M5 19h14a2 2 0 002-2v-5H3v5a2 2 0 002 2z"/>
                      </svg>
                      <span class="text-xs text-gray-400">In-Person</span>
                    <% } %>
                  </div>
                </div>
                <!-- Actions -->
                <div class="flex-shrink-0 flex items-center gap-2">
                  <% if (appt.status === 'upcoming') { %>
                    <button class="bg-teal-600 hover:bg-teal-700 text-white text-xs font-medium px-3 py-2 rounded-lg transition whitespace-nowrap">Start Consultation</button>
                    <button class="border border-gray-200 hover:bg-gray-50 text-gray-600 text-xs font-medium px-3 py-2 rounded-lg transition">Reschedule</button>
                  <% } else if (appt.status === 'in_progress') { %>
                    <button class="bg-teal-600 hover:bg-teal-700 text-white text-xs font-medium px-3 py-2 rounded-lg transition flex items-center gap-1.5">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                      </svg>
                      Complete
                    </button>
                  <% } else { %>
                    <button class="border border-gray-200 hover:bg-gray-50 text-gray-600 text-xs font-medium px-3 py-2 rounded-lg transition">View Record</button>
                  <% } %>
                </div>
              </div>
            <% }); %>

          </div>
        <% } else { %>
          <!-- No appointments placeholder -->
          <div class="bg-white rounded-2xl border border-gray-100 py-10 flex flex-col items-center gap-2 text-gray-300">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5"/>
            </svg>
            <p class="text-sm text-gray-400">No appointments for this day.</p>
          </div>
        <% } %>

      <% } else { %>
        <!-- Unavailable day placeholder -->
        <div class="bg-gray-50 border border-dashed border-gray-200 rounded-2xl py-12 flex flex-col items-center gap-2 text-gray-300">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
          </svg>
          <p class="text-sm text-gray-400"><%= cfg.unavailable_reason || 'Not available' %></p>
        </div>
      <% } %>

    </div><!-- /wday-panel -->

  <% }); %>

</div><!-- /tab-weekly -->

<script>
(function () {

  // ── Day tab switching ──────────────────────────────────────────────
  function selectWeekDay(idx) {
    document.querySelectorAll('.wday-panel').forEach(function(p) { p.classList.add('hidden'); });
    document.querySelectorAll('.wday-btn').forEach(function(b) {
      const i = parseInt(b.dataset.idx);
      b.classList.remove('bg-teal-600','text-white','border-teal-600',
                         'bg-white','text-gray-600','border-gray-200');
      if (i === idx) {
        b.classList.add('bg-teal-600','text-white','border-teal-600');
      } else {
        b.classList.add('bg-white','text-gray-600','border-gray-200');
      }
    });
    const panel = document.getElementById('wday-panel-' + idx);
    if (panel) panel.classList.remove('hidden');
  }
  window.selectWeekDay = selectWeekDay;

  // ── Slot config change tracker ─────────────────────────────────────
  const slotConfigs = {};

  function updateSlotConfig(idx, field, value) {
    if (!slotConfigs[idx]) slotConfigs[idx] = {};
    slotConfigs[idx][field] = value;
    console.log('Slot config updated [day ' + idx + ']:', slotConfigs[idx]);
  }
  window.updateSlotConfig = updateSlotConfig;

  function saveSlotConfig(idx) {
    const cfg = slotConfigs[idx] || {};
    console.log('Saving slot config for day', idx, cfg);
    // TODO: replace with your API call, e.g.:
    // fetch('/doctor/availability/day', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ dayIndex: idx, ...cfg }) });
    const btn = event.currentTarget;
    btn.textContent = 'Saved ✓';
    btn.classList.replace('bg-teal-600','bg-emerald-600');
    setTimeout(function() {
      btn.textContent = 'Save Slot Configuration';
      btn.classList.replace('bg-emerald-600','bg-teal-600');
    }, 2000);
  }
  window.saveSlotConfig = saveSlotConfig;

})();
</script>
