<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Satva</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#10A37F',
            'primary-dark': '#0d8a6a',
            'primary-light': '#e6f7f3',
            'bg-page': '#f0faf6',
            dark: '#0f1923',
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
          },
        }
      }
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    body { font-family: 'Inter', sans-serif; }
    .step-connector::after {
      content: '';
      position: absolute;
      top: 50%;
      left: calc(50% + 28px);
      width: calc(100% - 56px);
      height: 2px;
      background: #10A37F;
      transform: translateY(-50%);
    }
  </style>
</head>
<body class="bg-[#f0faf6] text-gray-800 min-h-screen">

  <!-- ===================== HERO ===================== -->
  <section class="flex flex-col items-center text-center px-4 pt-16 pb-12">
    <!-- Logo Icon -->
    <div class="bg-primary rounded-2xl p-3.5 mb-6 shadow-lg">
      <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
      </svg>
    </div>

    <h1 class="text-4xl font-bold text-gray-900 mb-4">Satva</h1>
    <h1 class="text-4xl font-bold text-gray-900 mb-4">Hospital Appointment System</h1>
    <p class="text-gray-500 max-w-md mb-8 leading-relaxed">
      Book appointments with top doctors, manage your health records, and get quality healthcare from the comfort of your home.
    </p>

    <!-- CTA Buttons -->
    <div class="flex flex-wrap gap-3 justify-center">
      <a href="/patient" class="bg-primary hover:bg-primary-dark text-white font-semibold px-6 py-2.5 rounded-lg flex items-center gap-2 transition">
        Patient Portal
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
      <a href="/doctor" class="border-2 border-gray-800 text-gray-800 hover:bg-gray-100 font-semibold px-6 py-2.5 rounded-lg transition">
        Doctor Login
      </a>
      <a href="/admin" class="bg-gray-900 hover:bg-gray-700 text-white font-semibold px-6 py-2.5 rounded-lg transition">
        Admin Panel
      </a>
    </div>
  </section>

  <!-- ===================== WHY CHOOSE US ===================== -->
  <section class="px-4 py-14 max-w-5xl mx-auto">
    <h2 class="text-2xl font-bold text-center text-gray-900 mb-10">Why Choose Us?</h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">

      <!-- Card 1 -->
      <div class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm">
        <div class="mb-3 text-primary">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
        </div>
        <h3 class="font-semibold text-gray-900 mb-1.5">Easy Booking</h3>
        <p class="text-sm text-gray-500 leading-relaxed">Book appointments in just a few clicks with real-time availability</p>
      </div>

      <!-- Card 2 -->
      <div class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm">
        <div class="mb-3 text-primary">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
          </svg>
        </div>
        <h3 class="font-semibold text-gray-900 mb-1.5">Telemedicine</h3>
        <p class="text-sm text-gray-500 leading-relaxed">Consult with doctors remotely via secure video calls</p>
      </div>

      <!-- Card 3 -->
      <div class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm">
        <div class="mb-3 text-primary">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <h3 class="font-semibold text-gray-900 mb-1.5">Secure Records</h3>
        <p class="text-sm text-gray-500 leading-relaxed">Your medical data is encrypted and HIPAA compliant</p>
      </div>

      <!-- Card 4 -->
      <div class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm">
        <div class="mb-3 text-primary">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
          </svg>
        </div>
        <h3 class="font-semibold text-gray-900 mb-1.5">24/7 Access</h3>
        <p class="text-sm text-gray-500 leading-relaxed">Manage appointments and view records anytime, anywhere</p>
      </div>

    </div>
  </section>

  <!-- ===================== HOW IT WORKS ===================== -->
  <section class="px-4 py-14 max-w-4xl mx-auto">
    <h2 class="text-2xl font-bold text-center text-gray-900 mb-14">How It Works</h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 text-center">

      <!-- Step 1 -->
      <div class="flex flex-col items-center relative">
        <div class="w-14 h-14 rounded-full bg-primary text-white flex items-center justify-center text-xl font-bold mb-4 shadow-md">1</div>
        <h3 class="font-semibold text-gray-900 mb-2">Create Account</h3>
        <p class="text-sm text-gray-500 leading-relaxed">Register with your email and phone number for secure access</p>
      </div>

      <!-- Step 2 -->
      <div class="flex flex-col items-center">
        <div class="w-14 h-14 rounded-full bg-primary text-white flex items-center justify-center text-xl font-bold mb-4 shadow-md">2</div>
        <h3 class="font-semibold text-gray-900 mb-2">Find Doctor</h3>
        <p class="text-sm text-gray-500 leading-relaxed">Search by specialty, location, or availability to find the right doctor</p>
      </div>

      <!-- Step 3 -->
      <div class="flex flex-col items-center">
        <div class="w-14 h-14 rounded-full bg-primary text-white flex items-center justify-center text-xl font-bold mb-4 shadow-md">3</div>
        <h3 class="font-semibold text-gray-900 mb-2">Book &amp; Consult</h3>
        <p class="text-sm text-gray-500 leading-relaxed">Book an appointment, pay online, and consult with your doctor</p>
      </div>

    </div>
  </section>

  <!-- ===================== STATS ===================== -->
  <section class="px-4 py-12 max-w-4xl mx-auto">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">

      <div>
        <p class="text-3xl font-bold text-primary">500+</p>
        <p class="text-sm text-gray-500 mt-1">Doctors</p>
      </div>
      <div>
        <p class="text-3xl font-bold text-primary">10K+</p>
        <p class="text-sm text-gray-500 mt-1">Patients</p>
      </div>
      <div>
        <p class="text-3xl font-bold text-primary">50K+</p>
        <p class="text-sm text-gray-500 mt-1">Appointments</p>
      </div>
      <div>
        <p class="text-3xl font-bold text-primary">4.8</p>
        <p class="text-sm text-gray-500 mt-1">Rating</p>
      </div>

    </div>
  </section>

  <!-- ===================== FEATURES + CTA ===================== -->
  <section class="px-4 py-14 max-w-5xl mx-auto">
    <div class="flex flex-col md:flex-row gap-10 items-start">

      <!-- Features list -->
      <div class="flex-1">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Complete Healthcare Management</h2>
        <ul class="space-y-3">
          <% [
            'Search doctors by specialty, location, and availability',
            'Book in-person or telemedicine appointments',
            'Secure electronic medical records (EMR)',
            'Automated appointment reminders via SMS & Email',
            'Integrated payment system with instant receipts',
            'Family member profile management'
          ].forEach(function(item) { %>
          <li class="flex items-start gap-3 text-gray-600">
            <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span class="text-sm leading-relaxed"><%= item %></span>
          </li>
          <% }) %>
        </ul>
      </div>

      <!-- CTA Card -->
      <div class="w-full md:w-80 bg-primary rounded-2xl p-7 text-white shadow-xl flex-shrink-0">
        <h3 class="text-xl font-bold mb-2">Ready to get started?</h3>
        <p class="text-green-100 text-sm mb-6 leading-relaxed">Join thousands of patients who trust us with their healthcare needs.</p>

        <a href="/register/patient" class="block w-full bg-white text-primary font-semibold text-center py-2.5 rounded-lg mb-3 hover:bg-green-50 transition">
          Register as Patient
        </a>

        <p class="text-green-200 text-xs text-center mb-2">Healthcare Professional?</p>

        <a href="/register/doctor" class="block w-full border border-white text-white font-semibold text-center py-2.5 rounded-lg mb-4 hover:bg-primary-dark transition">
          Join as Doctor
        </a>

        <a href="/admin" class="block text-center text-green-200 text-sm hover:text-white transition">
          Admin Access
        </a>
      </div>

    </div>
  </section>

  <!-- ===================== FOOTER ===================== -->
  <footer class="bg-[#0f1923] text-gray-400 py-8 px-4 mt-6">
    <div class="max-w-5xl mx-auto flex flex-col items-center gap-3 text-center">

      <div class="flex items-center gap-2">
        <div class="bg-primary rounded-lg p-1.5">
          <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
        </div>
        <span class="text-white font-semibold text-sm">HealthCare Appointment System</span>
      </div>

      <p class="text-xs text-gray-500">&copy; 2026 HealthCare. All rights reserved.</p>
      <p class="text-xs text-gray-600">HIPAA Compliant | Secure &amp; Encrypted</p>
    </div>
  </footer>

</body>
</html>