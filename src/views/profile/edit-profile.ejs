                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                      />
                    </svg>
                  </span>
                  <input
                    type="email"
                    name="email"
                    id="email"
                    value="john.doe@example.com"
                    disabled
                    class="w-full pl-10 pr-4 py-3 text-sm border border-gray-200 rounded-xl bg-gray-100 text-gray-500 cursor-not-allowed opacity-70"
                  />
                </div>
              </div>

              <div>
                <label
                  for="country_code"
                  class="block text-sm font-semibold text-gray-700 mb-1.5"
                  >Country Code</label
                >
                <select
                  id="country_code"
                  name="country_code"
                  required
                  class="w-full pr-10 pl-4 py-3 text-sm border border-gray-200 rounded-xl bg-gray-50 text-gray-700 transition"
                ></select>
                <p
                  id="country_code_error"
                  class="mt-1 text-xs text-red-500 hidden"
                ></p>
              </div>

              <div>
                <label
                  for="phone"
                  class="block text-sm font-semibold text-gray-700 mb-1.5"
                  >Mobile Number</label
                >
                <input
                  type="text"
                  name="phone"
                  id="phone"
                  required
                  value=""
                  class="w-full px-4 py-3 text-sm border border-gray-200 rounded-xl bg-gray-50 placeholder-gray-400 transition"
                />
                <p
                  id="phone_error"
                  class="mt-1 text-xs text-red-500 hidden"
                ></p>
              </div>

              <div>
                <label
                  for="dob"
                  class="block text-sm font-semibold text-gray-700 mb-1.5"
                  >Date of Birth</label
                >
                <input
                  type="date"
                  name="dob"
                  id="dob"
                  required
                  value=""
                  class="w-full px-4 py-3 text-sm border border-gray-200 rounded-xl bg-gray-50 text-gray-700 transition"
                />
                <p id="dob_error" class="mt-1 text-xs text-red-500 hidden"></p>
              </div>

              <div>
                <label
                  for="gender"
                  class="block text-sm font-semibold text-gray-700 mb-1.5"
                  >Gender</label
                >
                <select
                  id="gender"
                  name="gender"
                  required
                  class="w-full pr-10 pl-4 py-3 text-sm border border-gray-200 rounded-xl bg-gray-50 text-gray-700 transition"
                >
                  <option value="" disabled>Select Gender</option>
                  <option value="MALE" selected>Male</option>
                  <option value="FEMALE">Female</option>
                  <option value="OTHER">Other</option>
                </select>
                <p
                  id="gender_error"
                  class="mt-1 text-xs text-red-500 hidden"
                ></p>
              </div>

              <div class="md:col-span-2 lg:col-span-1">
                <label
                  for="blood_group"
                  class="block text-sm font-semibold text-gray-700 mb-1.5"
                  >Blood Group</label
                >
                <select
                  id="blood_group"
                  name="blood_group"
                  class="w-full pr-10 pl-4 py-3 text-sm border border-gray-200 rounded-xl bg-gray-50 text-gray-700 transition"
                >
                  <option value="" disabled>Select Blood Group</option>
                  <option value="A+">A+</option>
                  <option value="A-">A-</option>
                  <option value="B+">B+</option>
                  <option value="B-">B-</option>
                  <option value="O+" selected>O+</option>
                  <option value="O-">O-</option>
                  <option value="AB+">AB+</option>
                  <option value="AB-">AB-</option>
                </select>
                <p
                  id="blood_group_error"
                  class="mt-1 text-xs text-red-500 hidden"
                ></p>
              </div>

              <div class="hidden lg:block"></div>

              <div class="md:col-span-2">
                <label
                  for="address_1"
                  class="block text-sm font-semibold text-gray-700 mb-1.5"
                  >Address Line 1</label
                >
                <input
                  type="text"
                  name="address_1"
                  id="address_1"
                  required
                  placeholder="Street Address, P.O. Box, Company Name"
                  value=""
                  class="w-full px-4 py-3 text-sm border border-gray-200 rounded-xl bg-gray-50 placeholder-gray-400 transition"
                />
                <p
                  id="address_1_error"
                  class="mt-1 text-xs text-red-500 hidden"
                ></p>
              </div>

              <div class="md:col-span-2">
                <label
                  for="address_2"
                  class="block text-sm font-semibold text-gray-700 mb-1.5"
                  >Address Line 2</label
                >
                <input
                  type="text"
                  name="address_2"
                  id="address_2"
                  required
                  placeholder="Apartment, suite, unit, building, floor, etc."
                  value=""
                  class="w-full px-4 py-3 text-sm border border-gray-200 rounded-xl bg-gray-50 placeholder-gray-400 transition"
                />
                <p
                  id="address_2_error"
                  class="mt-1 text-xs text-red-500 hidden"
                ></p>
              </div>
            </div>

            <div
              class="pt-6 border-t border-gray-100 flex flex-col sm:flex-row gap-4 justify-end"
            >
              <button
                type="submit"
                class="w-full sm:w-auto py-3 px-8 bg-primary hover:bg-primary-dark text-white text-sm font-semibold rounded-xl shadow-md transition-all duration-200"
              >
                Save Changes
              </button>
            </div>
          </form>
        </div>
      </div>
    </main>

