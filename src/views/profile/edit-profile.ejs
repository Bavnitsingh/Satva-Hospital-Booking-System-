    <script>
      // Mobile menu toggle
      document.getElementById("menuBtn").addEventListener("click", () => {
        document.getElementById("mobileMenu").classList.toggle("hidden");
      });

      // DOB max = today
      document.getElementById("dob").max = new Date()
        .toISOString()
        .split("T")[0];

      // Profile Picture Preview functionality
      const profileUpload = document.getElementById("profile_upload");
      const profilePreview = document.getElementById("profile_preview");

      profileUpload.addEventListener("change", function (e) {
        const file = e.target.files[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = function (e) {
            profilePreview.src = e.target.result;
          };
          reader.readAsDataURL(file);
        }
      });

      // Country code dropdown (Same as Register page)
      fetch("https://restcountries.com/v3.1/all?fields=name,idd")
        .then((res) => res.json())
        .then((data) => {
          const select = document.getElementById("country_code");
          data
            .sort((a, b) => a.name.common.localeCompare(b.name.common))
            .forEach((country) => {
              const root = country.idd?.root || "";
              const suffix = country.idd?.suffixes?.[0] || "";
              const dial = root + suffix;
              if (!dial) return;
              const opt = document.createElement("option");
              opt.value = dial;
              opt.textContent = `${country.name.common} (${dial})`;
              // Pre-select India
              if (country.name.common === "India") opt.selected = true;
              select.appendChild(opt);
            });
        })
        .catch(() => {
          // Fallback if API fails
          const select = document.getElementById("country_code");
          const opt = document.createElement("option");
          opt.value = "+91";
          opt.textContent = "India (+91)";
          opt.selected = true;
          select.appendChild(opt);
        });

      // Validation Script
      const editForm = document.getElementById("editProfileForm");

      editForm.addEventListener("submit", function (e) {
        e.preventDefault();
        let isValid = true;

        // Clear previous errors
        document.querySelectorAll("[id$='_error']").forEach((el) => {
          el.textContent = "";
          el.classList.add("hidden");
        });

        document
          .querySelectorAll(".border-red-500")
          .forEach((el) => el.classList.remove("border-red-500"));

        const firstName = document.getElementById("first_name");
        const lastName = document.getElementById("last_name");
        const phone = document.getElementById("phone");
        const dob = document.getElementById("dob");
        const gender = document.getElementById("gender");
        const address1 = document.getElementById("address_1");
        const address2 = document.getElementById("address_2");

        function showError(input, errorId, message) {
          document.getElementById(errorId).textContent = message;
          document.getElementById(errorId).classList.remove("hidden");
          if (input) input.classList.add("border-red-500");
          isValid = false;
        }

        if (!firstName.value.trim())
          showError(firstName, "first_name_error", "First name is required");
        if (!lastName.value.trim())
          showError(lastName, "last_name_error", "Last name is required");

        if (!phone.value.trim()) {
          showError(phone, "phone_error", "Phone number is required");
        } else if (!/^[0-9]{6,15}$/.test(phone.value.trim())) {
          showError(phone, "phone_error", "Please enter a valid phone number");
        }

        if (!dob.value)
          showError(dob, "dob_error", "Date of birth is required");
        if (!gender.value)
          showError(gender, "gender_error", "Please select your gender");

        if (!address1.value.trim())
          showError(address1, "address_1_error", "Address Line 1 is required");
        if (!address2.value.trim())
          showError(address2, "address_2_error", "Address Line 2 is required");

        if (isValid) {
          console.log("Edit Profile Form Valid");
          // Proceed with fetch API to update profile route
        }
      });
    </script>
