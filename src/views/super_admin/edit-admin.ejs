<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Satva — Edit Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: "#10A37F",
                        "primary-dark": "#0d8a6a",
                        "primary-light": "#e6f7f3",
                        "bg-page": "#f0faf6",
                        dark: "#0f1923",
                    },
                    fontFamily: {
                        sans: ["'DM Sans'", "system-ui", "sans-serif"],
                        display: ["'Playfair Display'", "Georgia", "serif"],
                    },
                },
            },
        };
    </script>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        body { font-family: "DM Sans", sans-serif; }
    </style>
</head>
<body class="bg-bg-page text-gray-800 min-h-screen flex flex-col">

    <!-- Navbar -->
    <nav class="bg-white border-b border-gray-200 sticky top-0 z-50 shadow-sm">
        <div class="max-w-screen-2xl mx-auto px-6 py-4 flex items-center justify-between">
            <a href="/api/v1/super-admin/dashboard" class="flex items-center gap-2.5">
                <div class="bg-primary rounded-lg p-1.5">
                    <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                    </svg>
                </div>
                <span class="text-xl font-bold text-gray-900 font-display">Satva</span>
            </a>
            <div class="flex items-center gap-4">
                <a href="/api/v1/super-admin/dashboard" class="text-sm font-semibold text-gray-600 hover:text-primary transition flex items-center gap-2">
                    <i class="fa-solid fa-arrow-left"></i>
                    Back to Dashboard
                </a>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-1 max-w-3xl w-full mx-auto px-6 py-10">
        <div class="mb-8 flex items-center gap-4">
            <a href="/api/v1/super-admin/dashboard" class="p-2 rounded-full hover:bg-gray-200 transition text-gray-600">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div>
                <h2 class="text-2xl font-bold text-gray-800">Edit Administrator</h2>
                <p class="text-gray-500 text-sm mt-1">Modify details for <%= typeof admin !== 'undefined' ? admin.name : 'this admin' %>.</p>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-8">
            <form action="/api/v1/super-admin/edit-admin/<%= typeof admin !== 'undefined' ? admin.id : '1' %>?_method=PUT" method="POST" class="space-y-6">
                <!-- First and Last Name -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label for="first_name" class="block text-sm font-medium text-gray-700">First Name</label>
                        <div class="mt-1 relative rounded-md shadow-sm">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
                                <i class="fa-solid fa-user"></i>
                            </div>
                            <input type="text" name="first_name" id="first_name" required
                                value="<%= typeof admin !== 'undefined' ? admin.first_name : 'Admin' %>"
                                class="focus:ring-primary focus:border-primary block w-full pl-10 sm:text-sm border-gray-300 rounded-lg p-3 border outline-none transition"
                                placeholder="e.g. John">
                        </div>
                    </div>
                    <div>
                        <label for="last_name" class="block text-sm font-medium text-gray-700">Last Name</label>
                        <div class="mt-1 relative rounded-md shadow-sm">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
                                <i class="fa-solid fa-user"></i>
                            </div>
                            <input type="text" name="last_name" id="last_name" required
                                value="<%= typeof admin !== 'undefined' ? admin.last_name : 'User' %>"
                                class="focus:ring-primary focus:border-primary block w-full pl-10 sm:text-sm border-gray-300 rounded-lg p-3 border outline-none transition"
                                placeholder="e.g. Doe">
                        </div>
                    </div>
                </div>

                <!-- Hospital Selection -->
                <div>
                    <label for="hospital_id" class="block text-sm font-medium text-gray-700">Hospital</label>
                    <div class="mt-1 relative rounded-md shadow-sm">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
                            <i class="fa-solid fa-hospital"></i>
                        </div>
                        <select name="hospital_id" id="hospital_id" class="focus:ring-primary focus:border-primary block w-full pl-10 sm:text-sm border-gray-300 rounded-lg p-3 border outline-none transition appearance-none bg-white" required>
                            <% const currentHospital = typeof admin !== 'undefined' ? admin.hospital_id : ''; %>
                            <option value="">Select a Hospital</option>
                            <% if (typeof hospitals !== 'undefined' && hospitals.length > 0) { %>
                                <% hospitals.forEach(hospital => { %>
                                    <option value="<%= hospital.hospital_id %>" <%= currentHospital == hospital.hospital_id ? 'selected' : '' %>>
                                        <%= hospital.hospital_name %>
                                    </option>
                                <% }) %>
                            <% } %>
                        </select>
                        <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-gray-400">
                            <i class="fa-solid fa-chevron-down text-xs"></i>
                        </div>
                    </div>
                </div>

                <!-- Email -->
                <div>
                    <label for="email" class="block text-sm font-medium text-gray-700">Email Address</label>
                    <div class="mt-1 relative rounded-md shadow-sm">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
                            <i class="fa-solid fa-envelope"></i>
                        </div>
                        <input type="email" name="email" id="email" required
                            value="<%= typeof admin !== 'undefined' ? admin.email : 'admin@satva.health' %>"
                            class="focus:ring-primary focus:border-primary block w-full pl-10 sm:text-sm border-gray-300 rounded-lg p-3 border outline-none transition"
                            placeholder="admin@satva.health">
                    </div>
                </div>

                <!-- Password (Optional for edit) -->
                <div>
                    <label for="password" class="block text-sm font-medium text-gray-700">New Password <span class="text-gray-400 font-normal">(Leave blank to keep current)</span></label>
                    <div class="mt-1 relative rounded-md shadow-sm">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
                            <i class="fa-solid fa-lock"></i>
                        </div>
                        <input type="password" name="password" id="password"
                            class="focus:ring-primary focus:border-primary block w-full pl-10 sm:text-sm border-gray-300 rounded-lg p-3 border outline-none transition"
                            placeholder="••••••••">
                    </div>
                </div>

                <!-- Role -->
                <div>
                    <label for="role" class="block text-sm font-medium text-gray-700">Role</label>
                    <div class="mt-1 relative rounded-md shadow-sm">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
                            <i class="fa-solid fa-shield-halved"></i>
                        </div>
                        <select name="role" id="role" class="focus:ring-primary focus:border-primary block w-full pl-10 sm:text-sm border-gray-300 rounded-lg p-3 border outline-none transition appearance-none bg-white">
                            <% const currentRole = typeof admin !== 'undefined' ? admin.role : 'Admin'; %>
                            <option value="Admin" <%= currentRole === 'Admin' ? 'selected' : '' %>>Admin</option>
                            <option value="Manager" <%= currentRole === 'Manager' ? 'selected' : '' %>>Manager</option>
                            <option value="Super Admin" <%= currentRole === 'Super Admin' ? 'selected' : '' %>>Super Admin</option>
                        </select>
                        <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-gray-400">
                            <i class="fa-solid fa-chevron-down text-xs"></i>
                        </div>
                    </div>
                </div>

                <!-- Status -->
                <div>
                    <label for="status" class="block text-sm font-medium text-gray-700">Status</label>
                    <div class="mt-1 relative rounded-md shadow-sm">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
                            <i class="fa-solid fa-toggle-on"></i>
                        </div>
                        <select name="status" id="status" class="focus:ring-primary focus:border-primary block w-full pl-10 sm:text-sm border-gray-300 rounded-lg p-3 border outline-none transition appearance-none bg-white">
                            <% const currentStatus = typeof admin !== 'undefined' ? admin.status : 'Active'; %>
                            <option value="Active" <%= currentStatus === 'Active' ? 'selected' : '' %>>Active</option>
                            <option value="Inactive" <%= currentStatus === 'Inactive' ? 'selected' : '' %>>Inactive</option>
                        </select>
                        <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-gray-400">
                            <i class="fa-solid fa-chevron-down text-xs"></i>
                        </div>
                    </div>
                </div>

                <div class="pt-4 flex items-center justify-end gap-4 border-t border-gray-100 mt-6">
                    <a href="/api/v1/super-admin/dashboard" class="text-sm font-medium text-gray-600 hover:text-gray-900 transition">Cancel</a>
                    <button type="submit" class="bg-primary hover:bg-primary-dark text-white font-medium py-2.5 px-6 rounded-lg shadow-sm transition flex items-center gap-2">
                        <i class="fa-solid fa-save"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </main>

    <%- include("../error_flash") %>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const form = document.querySelector("form");
            if(form) {
                form.addEventListener("submit", async (e) => {
                    e.preventDefault();
                    const submitBtn = form.querySelector('button[type="submit"]');
                    const originalBtnText = submitBtn.innerHTML;
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Processing...';
                    
                    try {
                        const formData = new FormData(form);
                        const data = Object.fromEntries(formData.entries());
                        let url = form.action;
                        let method = "POST";
                        
                        if (url.includes("_method=PUT")) {
                            method = "PUT";
                            url = url.split("?")[0]; // remove query param for clean URL
                        }
                        
                        const response = await fetch(url, {
                            method: method,
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(data)
                        });

                        const result = await response.json();

                        if (!response.ok || result.statusCode >= 400) {
                            throw new Error(result.message || "An error occurred");
                        }

                        if(typeof setFlash === 'function') {
                            setFlash(result.message || "Admin updated successfully", "success");
                        }
                        
                        setTimeout(() => {
                            window.location.href = "/api/v1/super-admin/dashboard";
                        }, 500);

                    } catch (error) {
                        if(typeof showFlash === 'function') {
                            showFlash(error.message || "Failed to process request", "error");
                        } else {
                            alert(error.message || "Failed to process request");
                        }
                    } finally {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = originalBtnText;
                    }
                });
            }
        });
    </script>
</body>
</html>
