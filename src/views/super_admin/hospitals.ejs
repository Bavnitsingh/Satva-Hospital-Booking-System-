<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Satva Admin — Hospitals</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              primary: "#10A37F",
              "primary-dark": "#0d8a6a",
              "primary-light": "#e6f7f3",
              "bg-page": "#f0faf6",
              dark: "#0f1923",
            },
            fontFamily: {
              sans: ["'DM Sans'", "sans-serif"],
              display: ["'Playfair Display'", "serif"],
            },
          },
        },
      };
    </script>
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@700;800&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
  </head>
  <body class="bg-bg-page text-gray-800 min-h-screen flex flex-col">
    <main class="flex-1 max-w-screen-2xl w-full mx-auto px-6 py-8">
      <div
        class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4"
      >
        <div>
          <h1 class="text-2xl font-bold font-display text-gray-900">
            Manage Hospitals
          </h1>
          <p class="text-sm text-gray-500 mt-1">
            View, add, update, and remove registered hospitals.
          </p>
        </div>
        <a
          href="hospital-form.html"
          class="bg-primary hover:bg-primary-dark text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition shadow-sm flex items-center gap-2"
        >
          <i class="fa-solid fa-plus"></i> Add Hospital
        </a>
      </div>

      <div
        class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden"
      >
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr
                class="bg-gray-50 border-b border-gray-200 text-sm font-semibold text-gray-600"
              >
                <th class="px-6 py-4">ID</th>
                <th class="px-6 py-4">Hospital Name</th>
                <th class="px-6 py-4">City</th>
                <th class="px-6 py-4">Status</th>
                <th class="px-6 py-4 text-right">Actions</th>
              </tr>
            </thead>
            <tbody
              id="tableBody"
              class="divide-y divide-gray-100 text-sm"
            ></tbody>
          </table>
        </div>

        <div id="loadingIndicator" class="p-8 text-center text-primary hidden">
          <i class="fa-solid fa-circle-notch fa-spin text-2xl"></i>
        </div>

        <div
          class="border-t border-gray-200 px-6 py-4 flex items-center justify-between"
        >
          <p class="text-sm text-gray-500" id="pageInfo">Showing data...</p>
          <div class="flex items-center gap-2" id="paginationControls"></div>
        </div>
      </div>
    </main>

    <script>
      let currentPage = 1;
      const limit = 10;
      const apiUrl = "https://your-backend-api.com/api/hospitals"; // Replace with actual endpoint

      async function fetchHospitals(page) {
        document.getElementById("loadingIndicator").classList.remove("hidden");
        document.getElementById("tableBody").innerHTML = "";

        try {
          // Replace this fetch block with your actual API integration
          /*
          const response = await fetch(`${apiUrl}?page=${page}&limit=${limit}`);
          const data = await response.json();
          // Assuming data structure: { items: [], totalPages: 5, totalItems: 50 }
          renderTable(data.items);
          renderPagination(data.totalPages, page, data.totalItems);
          */

          // --- MOCK DATA FOR UI DEMONSTRATION ---
          setTimeout(() => {
            const mockData = {
              items: [
                {
                  id: `H-${page}01`,
                  name: "Apollo City Care",
                  city: "Ahmedabad",
                  status: "Active",
                },
                {
                  id: `H-${page}02`,
                  name: "CarePlus General",
                  city: "Pune",
                  status: "Active",
                },
                {
                  id: `H-${page}03`,
                  name: "Sunrise Medical",
                  city: "Mumbai",
                  status: "Inactive",
                },
              ],
              totalPages: 5,
              totalItems: 48,
            };
            document.getElementById("loadingIndicator").classList.add("hidden");
            renderTable(mockData.items);
            renderPagination(mockData.totalPages, page, mockData.totalItems);
          }, 500);
          // --------------------------------------
        } catch (error) {
          console.error("Failed to fetch data:", error);
          document.getElementById("tableBody").innerHTML =
            `<tr><td colspan="5" class="p-4 text-center text-red-500">Failed to load data.</td></tr>`;
        }
      }

      function renderTable(items) {
        const tbody = document.getElementById("tableBody");
        tbody.innerHTML = items
          .map(
            (item) => `
          <tr class="hover:bg-gray-50 transition">
            <td class="px-6 py-4 text-gray-500 font-medium">${item.id}</td>
            <td class="px-6 py-4 font-semibold text-gray-900">${item.name}</td>
            <td class="px-6 py-4 text-gray-600">${item.city}</td>
            <td class="px-6 py-4">
              <span class="px-2.5 py-1 text-xs font-semibold rounded-full ${item.status === "Active" ? "bg-emerald-100 text-emerald-700" : "bg-red-100 text-red-700"}">
                ${item.status}
              </span>
            </td>
            <td class="px-6 py-4 text-right space-x-2">
              <a href="hospital-form.html?id=${item.id}&action=view" class="text-blue-500 hover:text-blue-700" title="View"><i class="fa-regular fa-eye"></i></a>
              <a href="hospital-form.html?id=${item.id}&action=edit" class="text-primary hover:text-primary-dark" title="Edit"><i class="fa-regular fa-pen-to-square"></i></a>
              <button onclick="deleteRecord('${item.id}')" class="text-red-500 hover:text-red-700" title="Delete"><i class="fa-regular fa-trash-can"></i></button>
            </td>
          </tr>
        `,
          )
          .join("");
      }

      function renderPagination(totalPages, currentPage, totalItems) {
        const controls = document.getElementById("paginationControls");
        document.getElementById("pageInfo").innerText =
          `Showing page ${currentPage} of ${totalPages} (${totalItems} total records)`;

        let html = "";

        // Prev button
        html += `<button onclick="changePage(${currentPage - 1})" ${currentPage === 1 ? "disabled" : ""} class="px-3 py-1.5 border border-gray-200 rounded-lg text-sm font-medium ${currentPage === 1 ? "text-gray-300 bg-gray-50 cursor-not-allowed" : "text-gray-700 hover:bg-gray-50"}">Prev</button>`;

        // Page numbers
        for (let i = 1; i <= totalPages; i++) {
          if (i === currentPage) {
            html += `<button class="px-3.5 py-1.5 rounded-lg text-sm font-semibold bg-primary text-white">${i}</button>`;
          } else {
            html += `<button onclick="changePage(${i})" class="px-3.5 py-1.5 rounded-lg text-sm font-medium text-gray-600 hover:bg-gray-100">${i}</button>`;
          }
        }

        // Next button
        html += `<button onclick="changePage(${currentPage + 1})" ${currentPage === totalPages ? "disabled" : ""} class="px-3 py-1.5 border border-gray-200 rounded-lg text-sm font-medium ${currentPage === totalPages ? "text-gray-300 bg-gray-50 cursor-not-allowed" : "text-gray-700 hover:bg-gray-50"}">Next</button>`;

        controls.innerHTML = html;
      }

      function changePage(page) {
        currentPage = page;
        fetchHospitals(currentPage);
      }

      function deleteRecord(id) {
        if (confirm(`Are you sure you want to delete record ${id}?`)) {
          // Implement Delete Fetch API logic here
          alert(`Deleted ${id}`);
          fetchHospitals(currentPage);
        }
      }

      // Initial Load
      fetchHospitals(currentPage);
    </script>
  </body>
</html>
